# Copy to /etc/ecoguard/compose.env after choosing a reviewed local image.
# Values are literal KEY=value, no shell expansion or secrets.
ECOGUARD_IMAGE=ecoguard-inference:REPLACE_WITH_REVIEWED_COMMIT
ECOGUARD_ENV_FILE=/etc/ecoguard/inference.env
ECOGUARD_CONFIG_DIR=/opt/ecoguard/config
ECOGUARD_MODEL_DIR=/var/lib/ecoguard/models
