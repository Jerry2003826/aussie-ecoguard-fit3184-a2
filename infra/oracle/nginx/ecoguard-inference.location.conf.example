# REVIEW ONLY. Include inside the EXISTING, correctly certified HTTPS server {}.
# Do not replace nginx.conf, certificates, existing routes, or listeners.
# Public base URL / token audience: https://<existing-domain>/ecoguard-inference
# Existing site's auth/rewrite/regex rules must be reviewed for conflicts first.

location ^~ /ecoguard-inference/v1/ {
    if ($request_method != POST) { return 405; }
    rewrite ^/ecoguard-inference(/v1/.*)$ $1 break;
    proxy_pass http://127.0.0.1:18080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Serverless-Authorization $http_x_serverless_authorization;
    proxy_set_header Authorization $http_authorization;
    client_max_body_size 1m;
    client_body_buffer_size 1m;
    proxy_connect_timeout 3s;
    proxy_send_timeout 30s;
    proxy_read_timeout 390s;
    proxy_request_buffering on;
    proxy_buffering off;
    proxy_next_upstream off;
    access_log off;
    # Keep the existing error log at warn/error; do not enable debug logging.
    add_header Cache-Control "no-store" always;
}

# Keep health/readiness and any future routes off the public proxy.
location ^~ /ecoguard-inference/ {
    return 404;
}
