# Copy to /etc/ecoguard/inference.env, mode 0600, before validation.
# Oracle verifies the complete Google-signed ID token cryptographically.
SERVICE_AUTH_MODE=oracle
SERVICE_TOKEN_AUDIENCE=https://REPLACE_WITH_EXISTING_DOMAIN/ecoguard-inference
SERVICE_TOKEN_EMAIL=REPLACE_WITH_WIF_INVOKER@REPLACE_WITH_PROJECT.iam.gserviceaccount.com
# Must match the deployed Cognito pool and app client, not another course project.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_WITH_POOL_ID
COGNITO_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
# Exact bucket hostname only; comma-separated hosts if genuinely needed.
SOURCE_S3_HOSTS=REPLACE_WITH_BUCKET.s3.us-east-1.amazonaws.com
SOURCE_KEY_PREFIXES=derived/,queries/
MODEL_MANIFEST_PATH=/config/model.locked.json
MODEL_MANIFEST_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_SHA256
TAXONOMY_PATH=/config/taxonomy.json
MODEL_CACHE_DIR=/models
INFERENCE_TIMEOUT_SECONDS=330
TORCH_THREADS=4
OMP_NUM_THREADS=4
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Do not set LOCAL_SERVICE_TOKEN, K_SERVICE, or GOOGLE_APPLICATION_CREDENTIALS.
# No AWS, Google, Oracle, or Cognito long-lived credential belongs here.
